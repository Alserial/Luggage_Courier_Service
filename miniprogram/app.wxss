page {
  min-height: 100vh;
  background: #efe8d8;
  color: #3d4634;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

view,
text,
button,
input,
textarea,
picker,
image {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
}

.section {
  margin: 32rpx 0;
}

.section-title {
  margin-bottom: 18rpx;
  color: #3d4634;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted {
  color: #7f8778;
}

.page-header {
  margin-bottom: 30rpx;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #7f9070;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
  line-height: 1.3;
}

.page-title {
  color: #3d4634;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
}

.page-desc {
  max-width: 640rpx;
  margin-top: 14rpx;
  color: #7f8778;
  font-size: 25rpx;
  line-height: 1.6;
}

.card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e1d8c3;
  border-radius: 20rpx;
  background: #fffdf7;
  box-shadow: 0 8rpx 22rpx rgba(61, 70, 52, 0.045);
}

.card-title {
  color: #3d4634;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-desc {
  margin-top: 8rpx;
  color: #7f8778;
  font-size: 25rpx;
  line-height: 1.55;
}

.meta-line {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-top: 12rpx;
  color: #7f8778;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-pill {
  flex-shrink: 0;
  padding: 9rpx 17rpx;
  border: 1rpx solid #d5dfcf;
  border-radius: 999rpx;
  background: #eef3ea;
  color: #52714d;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.status-warning {
  border-color: #ead9b3;
  background: #f7edd7;
  color: #8a681f;
}

.status-danger {
  border-color: #efd3ca;
  background: #fbefeb;
  color: #a64d3b;
}

.status-neutral {
  border-color: #ded9cb;
  background: #f4f1e8;
  color: #686f62;
}

.surface-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #4a5142;
  font-size: 26rpx;
  font-weight: 700;
}

.input,
.textarea {
  width: 100%;
  min-height: 90rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #ded5c1;
  border-radius: 16rpx;
  background: #fffdf7;
  color: #3d4634;
  font-size: 28rpx;
  line-height: 1.45;
}

.textarea {
  min-height: 176rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.primary-button {
  background: #7f9070;
  color: #fffdf7;
}

.primary-button[disabled] {
  background: #b7bead;
  color: #f4f1e8;
}

.secondary-button {
  border: 1rpx solid #bfc8b5;
  background: #fffdf7;
  color: #5f6e54;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 11rpx 18rpx;
  border: 1rpx solid #d7d2c3;
  border-radius: 999rpx;
  background: #fffdf7;
  color: #62695b;
  font-size: 24rpx;
  line-height: 1.25;
}

.tag-active {
  border-color: #7f9070;
  background: #7f9070;
  color: #fffdf7;
  font-weight: 700;
}

.warning {
  border-color: #ead9b3;
  background: #f7edd7;
  color: #765b22;
}

.notice-card {
  border-color: #d5dfcf;
  background: #eef3ea;
  color: #4f694b;
}

.safe-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  overflow: hidden;
  border-radius: 9rpx 9rpx 20rpx 9rpx;
  background: #7f9070;
}

.brand-mark::before {
  position: absolute;
  top: 23rpx;
  left: 0;
  width: 58rpx;
  height: 4rpx;
  background: #efe8d8;
  content: "";
}

.brand-mark::after {
  position: absolute;
  right: -5rpx;
  bottom: 10rpx;
  width: 37rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #efe8d8;
  content: "";
  transform: rotate(-42deg);
}

.brand-word {
  color: #3d4634;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}
