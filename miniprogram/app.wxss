page {
  min-height: 100vh;
  background: #f4f7f8;
  color: #17202a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
}

.section {
  margin: 28rpx 0;
}

.section-title {
  margin-bottom: 18rpx;
  color: #16202a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.muted {
  color: #667085;
}

.page-header {
  margin-bottom: 28rpx;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
}

.page-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
}

.page-desc {
  margin-top: 14rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(15, 118, 110, 0.08);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.card-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
}

.meta-line {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.4;
}

.status-pill {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border: 1rpx solid rgba(15, 118, 110, 0.14);
  border-radius: 999rpx;
  background: #e8f6f3;
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status-warning {
  border-color: rgba(217, 119, 6, 0.18);
  background: #fff7ed;
  color: #b45309;
}

.status-danger {
  border-color: rgba(220, 38, 38, 0.18);
  background: #fef2f2;
  color: #b91c1c;
}

.status-neutral {
  border-color: #e5e7eb;
  background: #f8fafc;
  color: #475467;
}

.surface-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #263443;
  font-size: 27rpx;
  font-weight: 700;
}

.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d9e2e7;
  border-radius: 14rpx;
  background: #ffffff;
  color: #111827;
  font-size: 29rpx;
  line-height: 1.45;
}

.textarea {
  min-height: 176rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

button::after {
  border: 0;
}

.primary-button {
  background: #0f766e;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(15, 118, 110, 0.18);
}

.secondary-button {
  border: 1rpx solid rgba(15, 118, 110, 0.26);
  background: #ffffff;
  color: #0f766e;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border: 1rpx solid #d9e2e7;
  border-radius: 999rpx;
  background: #ffffff;
  color: #344054;
  font-size: 24rpx;
  line-height: 1.25;
}

.tag-active {
  border-color: rgba(15, 118, 110, 0.2);
  background: #e8f6f3;
  color: #0f766e;
  font-weight: 700;
}

.warning {
  border-color: rgba(217, 119, 6, 0.16);
  background: #fffaf0;
  color: #92400e;
}

.notice-card {
  border-color: rgba(15, 118, 110, 0.12);
  background: #f0fdfa;
  color: #115e59;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
