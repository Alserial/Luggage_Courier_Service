<view class="page">
  <view class="section-title">发起争议</view>
  <view class="card warning">
    <view class="rule-line">争议会冻结未放款服务费或保持 Mock 锁定状态。平台只依据平台内证据处理。</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">争议原因</text>
      <picker mode="selector" range="{{reasons}}" value="{{reasonIndex}}" bindchange="onReasonChange">
        <view class="input">{{selectedReason}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">详细说明</text>
      <textarea class="textarea" placeholder="说明事实、时间线和你已有的证据" value="{{description}}" bindinput="onDescriptionInput" />
    </view>
  </view>

  <button class="secondary-button" bindtap="goEvidence">补充证据</button>
  <button class="primary-button submit-button" loading="{{submitting}}" bindtap="openDispute">提交争议</button>
</view>
