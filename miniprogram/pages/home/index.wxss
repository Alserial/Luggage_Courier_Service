.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 32rpx 30rpx;
  border: 1rpx solid rgba(15, 118, 110, 0.1);
  border-radius: 18rpx;
  background: #0f766e;
  color: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(15, 118, 110, 0.18);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 30rpx;
}

.metric {
  padding: 16rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.1);
}

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  font-size: 25rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-card {
  min-height: 214rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(15, 118, 110, 0.1);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  text-align: left;
}

.action-eyebrow,
.action-title,
.action-desc {
  display: block;
}

.action-eyebrow {
  margin-bottom: 24rpx;
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 800;
}

.action-title {
  color: #111827;
  font-size: 33rpx;
  font-weight: 900;
}

.action-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.status-title {
  margin-bottom: 8rpx;
  color: #102a27;
  font-size: 30rpx;
  font-weight: 800;
}

.mini-button {
  display: flex;
  width: 124rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.boundary-card {
  border-color: rgba(217, 119, 6, 0.12);
  background: #fffaf0;
}

.rule-line {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  margin: 12rpx 0;
  color: #6d4c12;
  font-size: 26rpx;
  line-height: 1.5;
}

.rule-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #d97706;
  flex-shrink: 0;
}
