.home-page {
  padding-top: 24rpx;
}

.brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.brand-caption {
  margin-top: 6rpx;
  color: #8b9382;
  font-size: 20rpx;
  line-height: 1;
}

.profile-chip {
  width: auto;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #d8cfbb;
  border-radius: 999rpx;
  background: #fffdf7;
  color: #5f6e54;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.hero {
  overflow: hidden;
  padding: 40rpx 34rpx 32rpx;
  border-radius: 24rpx;
  background: #3d4634;
  color: #efe8d8;
}

.hero-eyebrow {
  color: #aeb9a3;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 39rpx;
  font-weight: 800;
  line-height: 1.32;
}

.hero-subtitle {
  margin-top: 18rpx;
  color: #c7ccbE;
  font-size: 24rpx;
  line-height: 1.6;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 30rpx;
}

.metric {
  padding: 16rpx 12rpx;
  border: 1rpx solid rgba(239, 232, 216, 0.2);
  border-radius: 14rpx;
  background: rgba(239, 232, 216, 0.08);
}

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  font-size: 25rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 5rpx;
  color: #bfc5b6;
  font-size: 19rpx;
}

.pending-strip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e7d5aa;
  border-radius: 18rpx;
  background: #f7edd7;
}

.pending-mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #c99a3f;
  color: #fffdf7;
  font-size: 28rpx;
  font-weight: 800;
}

.pending-copy {
  min-width: 0;
  flex: 1;
}

.pending-title {
  color: #70591f;
  font-size: 25rpx;
  font-weight: 700;
}

.pending-desc {
  margin-top: 4rpx;
  color: #98752e;
  font-size: 21rpx;
  line-height: 1.4;
}

.pending-link {
  flex-shrink: 0;
  color: #765b22;
  font-size: 23rpx;
  font-weight: 700;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 34rpx 0 18rpx;
}

.section-heading .section-title {
  margin-bottom: 0;
}

.section-subtitle {
  margin-top: 5rpx;
  color: #8b9382;
  font-size: 22rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.action-card {
  display: flex;
  min-height: 280rpx;
  flex-direction: column;
  align-items: flex-start;
  margin: 0;
  padding: 26rpx;
  border: 1rpx solid #e1d8c3;
  border-radius: 20rpx;
  background: #fffdf7;
  color: #3d4634;
  text-align: left;
}

.action-card-primary {
  border-color: #7f9070;
  background: #7f9070;
  color: #fffdf7;
}

.action-index {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  border-radius: 14rpx;
  background: #eef1e7;
  color: #5f6e54;
  font-size: 20rpx;
  font-weight: 800;
}

.action-card-primary .action-index {
  background: rgba(255, 253, 247, 0.16);
  color: #fffdf7;
}

.action-title {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.action-desc {
  margin-top: 10rpx;
  color: #7f8778;
  font-size: 22rpx;
  line-height: 1.48;
}

.action-card-primary .action-desc {
  color: #e4e6df;
}

.action-link {
  margin-top: auto;
  padding-top: 22rpx;
  color: #5f6e54;
  font-size: 22rpx;
  font-weight: 700;
}

.action-card-primary .action-link {
  color: #fffdf7;
}

.rules-link {
  color: #5f6e54;
  font-size: 23rpx;
  font-weight: 700;
}

.boundary-card {
  padding: 26rpx 28rpx;
  border: 1rpx solid #e1d8c3;
  border-radius: 20rpx;
  background: #fffdf7;
}

.rule-line {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  padding: 10rpx 0;
  color: #636b5c;
  font-size: 24rpx;
  line-height: 1.5;
}

.rule-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #b5654a;
  flex-shrink: 0;
}
