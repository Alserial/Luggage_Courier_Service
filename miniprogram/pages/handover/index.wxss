.rule-line {
  font-size: 26rpx;
  line-height: 1.55;
}

.qr-card {
  text-align: center;
}

.qr-box {
  display: flex;
  height: 220rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #7f9070;
  border-radius: 8rpx;
  background: #eef3ea;
  color: #5f6e54;
  font-size: 32rpx;
  font-weight: 800;
}

.qr-title {
  margin-top: 18rpx;
  color: #3d4634;
  font-size: 30rpx;
  font-weight: 800;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 16rpx 0;
  color: #5f6658;
  font-size: 27rpx;
  line-height: 1.45;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  border: 2rpx solid #9ea895;
  border-radius: 8rpx;
  background: #fffdf7;
}

.checked {
  border-color: #7f9070;
  background: #7f9070;
}

.evidence-button {
  margin-top: 18rpx;
}
