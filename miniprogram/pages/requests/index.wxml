<view class="page">
  <view class="section-title">我的需求</view>
  <view class="card request-card" bindtap="goDetail">
    <view>
      <view class="empty-title">{{request.itemName}}</view>
      <view class="muted">{{request.route}} · {{request.categoryLabel}}</view>
    </view>
    <view class="status-pill">已审核</view>
  </view>
  <button class="primary-button" bindtap="goCreate">发布需求</button>
  <button class="secondary-button rule-button" bindtap="goRules">查看品类规则</button>
</view>
