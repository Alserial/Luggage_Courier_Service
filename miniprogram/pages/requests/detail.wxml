<view class="page">
  <view wx:if="{{loading}}" class="card">
    <view class="muted">正在加载需求详情...</view>
  </view>

  <view wx:if="{{errorText}}" class="card">
    <view class="detail-error">{{errorText}}</view>
  </view>

  <block wx:if="{{!loading && !errorText}}">
  <view class="card">
    <view class="detail-heading">
      <view class="eyebrow">REQUEST DETAIL</view>
      <view class="status-pill {{request.reviewStatus === 'approved' ? '' : 'status-warning'}}">{{statusLabel}}</view>
    </view>
    <view class="detail-title">{{request.itemName}}</view>
    <view class="meta-line">
      <text>{{request.route}}</text>
      <text>{{request.categoryLabel}}</text>
    </view>
  </view>

  <view wx:if="{{request.itemPhotos.length}}" class="card">
    <view class="section-title compact-title">物品图片</view>
    <view class="detail-photo-grid">
      <image wx:for="{{request.itemPhotos}}" wx:key="*this" class="detail-photo" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewItemPhoto" />
    </view>
  </view>

  <view class="card">
    <view class="info-row"><text>申报价值</text><text>CNY {{request.declaredValue}}</text></view>
    <view class="info-row"><text>预估重量</text><text>{{request.estimatedWeightKg}}kg</text></view>
    <view class="info-row"><text>最晚送达</text><text>{{request.deadline}}</text></view>
  </view>

  <view class="card">
    <view class="section-title compact-title">风险标签</view>
    <view class="tag-row">
      <view class="tag tag-active" wx:for="{{request.riskFlags}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{isOwner && hasOffer}}" class="card offer-card">
    <view>
      <view class="offer-title">{{offer.travellerName}} 的报价</view>
      <view class="muted">{{offer.conditions}}</view>
    </view>
    <view class="offer-fee">CNY {{offer.serviceFeeQuote}}</view>
  </view>

  <view wx:elif="{{isOwner}}" class="card">
    <view class="muted">暂无待处理报价。</view>
  </view>

  <view wx:else class="card public-notice">
    <view class="section-title compact-title">公开需求</view>
    <view class="muted">该需求已通过平台审核。发布者身份和报价记录不会在公开页面展示。</view>
  </view>

  <button wx:if="{{isOwner && hasOffer}}" class="primary-button" loading="{{accepting}}" disabled="{{accepting || deleting}}" bindtap="acceptOffer">接受报价并生成订单</button>
  <view wx:if="{{isOwner}}" class="manage-actions">
    <view class="manage-row">
      <button class="secondary-button" disabled="{{accepting || deleting}}" bindtap="goEdit">编辑需求</button>
      <button class="danger-button" loading="{{deleting}}" disabled="{{accepting || deleting}}" bindtap="confirmDelete">删除需求</button>
    </view>
    <view class="manage-helper">修改后需要重新审核，待处理报价会失效；已有订单时不能修改或删除。</view>
  </view>
  </block>
</view>
