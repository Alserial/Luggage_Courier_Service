.detail-title {
  color: #3d4634;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.compact-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee6d4;
  color: #5f6658;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.offer-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.offer-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.offer-fee {
  flex-shrink: 0;
  color: #5f6e54;
  font-size: 30rpx;
  font-weight: 900;
}

.detail-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.detail-photo {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 10rpx;
  background: #eee8d9;
}

.detail-error {
  color: #a64d3b;
  font-size: 28rpx;
}

.public-notice {
  border-left: 6rpx solid #7f9070;
}

.manage-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
}

.manage-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.danger-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #d9b7ad;
  border-radius: 16rpx;
  background: #fffdf7;
  color: #a64d3b;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
}

.manage-helper {
  color: #8b9382;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}
