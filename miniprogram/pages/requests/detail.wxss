.detail-title {
  color: #111827;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.compact-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f3f5;
  color: #374151;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.offer-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.offer-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.offer-fee {
  flex-shrink: 0;
  color: #0f766e;
  font-size: 30rpx;
  font-weight: 900;
}
