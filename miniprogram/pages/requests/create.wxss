.risk-check {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border: 2rpx solid #9ca3af;
  border-radius: 8rpx;
  background: #ffffff;
}

.checked {
  border-color: #0f766e;
  background: #0f766e;
}

.risk-text {
  flex: 1;
  color: #374151;
  font-size: 26rpx;
  line-height: 1.5;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.photo-label {
  margin-bottom: 0;
}

.photo-count {
  color: #667085;
  font-size: 24rpx;
}

.photo-helper {
  margin: 10rpx 0 18rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.photo-item,
.photo-add {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 12rpx;
}

.photo-item {
  background: #eef2f4;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.76);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx dashed #9fb3bd;
  background: #f8fafb;
  color: #52636d;
  font-size: 23rpx;
}

.photo-add-icon {
  color: #0f766e;
  font-size: 44rpx;
  line-height: 1;
}

.upload-progress {
  margin-top: 14rpx;
  color: #0f766e;
  font-size: 24rpx;
}
