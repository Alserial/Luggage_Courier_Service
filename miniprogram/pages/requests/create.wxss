.form-notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #ead9b3;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.notice-mark {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #c99a3f;
  color: #fffdf7;
  font-weight: 800;
  flex-shrink: 0;
}

.form-section {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #e1d8c3;
  border-radius: 20rpx;
  background: #fffdf7;
}

.form-section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #eee6d4;
}

.section-index {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  background: #eef1e7;
  color: #5f6e54;
  font-size: 18rpx;
  font-weight: 800;
}

.form-section-title {
  color: #3d4634;
  font-size: 28rpx;
  font-weight: 800;
}

.form-section-desc {
  margin-top: 4rpx;
  color: #8b9382;
  font-size: 21rpx;
}

.form-section .input,
.form-section .textarea {
  background: #fdfaf2;
}

.value-grid,
.route-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.money-input {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #7f9070;
  font-size: 31rpx;
  font-weight: 800;
}

.money-input input {
  min-width: 0;
  flex: 1;
  color: #3d4634;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}

.picker-value {
  color: #5f6658;
}

.optional {
  color: #9da392;
  font-size: 21rpx;
  font-weight: 400;
}

.field-last {
  margin-bottom: 0;
}

.risk-check {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #d5dfcf;
  border-radius: 18rpx;
  background: #eef3ea;
}

.checkbox {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  border: 2rpx solid #9ea895;
  border-radius: 9rpx;
  background: #fffdf7;
  color: #fffdf7;
  font-size: 24rpx;
  line-height: 1;
}

.checked {
  border-color: #7f9070;
  background: #7f9070;
}

.risk-text {
  flex: 1;
  color: #4f624a;
  font-size: 24rpx;
  line-height: 1.55;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.photo-label {
  margin-bottom: 0;
}

.photo-count {
  color: #7f8778;
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
}

.photo-helper {
  margin: 10rpx 0 18rpx;
  color: #7f8778;
  font-size: 23rpx;
  line-height: 1.5;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.photo-item,
.photo-add {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 14rpx;
}

.photo-item {
  background: #eee8d9;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(61, 70, 52, 0.78);
  color: #fffdf7;
  font-size: 30rpx;
  line-height: 1;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed #b9c0ae;
  background: #f7f3e9;
  color: #6f7769;
  font-size: 22rpx;
}

.photo-add-icon {
  color: #7f9070;
  font-size: 42rpx;
  line-height: 1;
}

.upload-progress {
  margin-top: 14rpx;
  color: #5f6e54;
  font-size: 24rpx;
}

.form-state {
  padding: 40rpx 28rpx;
  text-align: center;
}

.form-error {
  color: #a64d3b;
  font-size: 26rpx;
  line-height: 1.5;
}
