.scope-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-bottom: 26rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #ded5c1;
}

.scope-tab {
  padding: 19rpx 12rpx;
  border-radius: 12rpx;
  color: #7f8778;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.scope-tab-active {
  background: #fffdf7;
  color: #3d4634;
  font-weight: 700;
  box-shadow: 0 3rpx 8rpx rgba(61, 70, 52, 0.06);
}

.trip-card {
  padding: 30rpx;
}

.list-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.route-title {
  min-width: 0;
  color: #3d4634;
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.trip-facts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.fact {
  padding: 17rpx 18rpx;
  border-radius: 14rpx;
  background: #f4f1e8;
}

.fact-label {
  color: #8b9382;
  font-size: 20rpx;
}

.fact-value {
  margin-top: 5rpx;
  color: #4a5142;
  font-size: 25rpx;
  font-weight: 700;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.category-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef3ea;
  color: #5f6e54;
  font-size: 21rpx;
}

.card-link {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee6d4;
  color: #5f6e54;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.list-state {
  padding: 42rpx 28rpx;
  text-align: center;
}

.empty-mark {
  display: inline-flex;
  min-width: 92rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #eef1e7;
  color: #7f9070;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.empty-title {
  margin-bottom: 8rpx;
  color: #3d4634;
  font-size: 28rpx;
  font-weight: 700;
}

.error-text {
  color: #a64d3b;
  font-size: 27rpx;
}

.retry-button {
  margin-top: 20rpx;
}
