<view class="page">
  <view wx:if="{{loading}}" class="card">
    <view class="muted">正在加载行程详情...</view>
  </view>

  <view wx:if="{{errorText}}" class="card">
    <view class="detail-error">{{errorText}}</view>
  </view>

  <block wx:if="{{!loading && !errorText}}">
  <view class="card">
    <view class="detail-heading">
      <view class="eyebrow">TRIP DETAIL</view>
      <view class="status-pill {{trip.verificationStatus === 'approved' ? '' : 'status-warning'}}">{{statusLabel}}</view>
    </view>
    <view class="detail-title">{{trip.route}}</view>
    <view class="meta-line">
      <text>{{trip.departureDate}} 出发</text>
      <text>{{trip.arrivalDate}} 到达</text>
    </view>
  </view>

  <view class="card">
    <view class="info-row"><text>航班</text><text>{{trip.flightNo}}</text></view>
    <view class="info-row"><text>可用重量</text><text>{{trip.capacityKg}}kg</text></view>
  </view>

  <view class="card">
    <view class="section-title compact-title">可接受品类</view>
    <view class="tag-row">
      <view class="tag tag-active" wx:for="{{trip.categories}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{isOwner}}" class="manage-actions">
    <button class="primary-button" disabled="{{trip.verificationStatus !== 'approved'}}" bindtap="goMatches">{{trip.verificationStatus === 'approved' ? '查看匹配需求' : '核验通过后可查看匹配'}}</button>
    <view class="manage-row">
      <button class="secondary-button" bindtap="goEdit">编辑行程</button>
      <button class="danger-button" loading="{{deleting}}" disabled="{{deleting}}" bindtap="confirmDelete">删除行程</button>
    </view>
    <view class="manage-helper">修改后需要重新核验；已有订单时不能修改或删除。</view>
  </view>
  <view wx:else class="card public-notice">
    <view class="section-title compact-title">公开行程</view>
    <view class="muted">该行程已通过平台核验。携带者身份和私密资料不会在公开页面展示。</view>
  </view>
  </block>
</view>
