<view class="page">
  <view class="page-header">
    <view class="eyebrow">TRIPS</view>
    <view class="page-title">同行行程</view>
    <view class="page-desc">公开大厅只展示平台已核验的有效行程；“我的发布”可管理自己的路线。</view>
  </view>

  <view class="scope-tabs" role="tablist">
    <view class="scope-tab {{scope === 'market' ? 'scope-tab-active' : ''}}" data-scope="market" bindtap="switchScope">公开大厅</view>
    <view class="scope-tab {{scope === 'mine' ? 'scope-tab-active' : ''}}" data-scope="mine" bindtap="switchScope">我的发布</view>
  </view>

  <view wx:if="{{loading}}" class="card list-state">
    <view class="muted">正在加载行程...</view>
  </view>

  <view wx:if="{{errorText}}" class="card list-state">
    <view class="error-text">{{errorText}}</view>
    <button class="secondary-button retry-button" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:if="{{!loading && !errorText}}" class="card trip-card" wx:for="{{trips}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="list-card-head">
      <view class="route-title">{{item.route}}</view>
      <view class="status-pill status-neutral">{{scope === 'market' ? '已核验' : item.verificationStatus}}</view>
    </view>
    <view class="trip-facts">
      <view class="fact">
        <view class="fact-label">出发日期</view>
        <view class="fact-value">{{item.departureDate}}</view>
      </view>
      <view class="fact">
        <view class="fact-label">可用重量</view>
        <view class="fact-value">{{item.capacityKg}} kg</view>
      </view>
    </view>
    <view class="category-row">
      <view class="category-chip" wx:for="{{item.categories}}" wx:for-item="category" wx:key="*this">{{category}}</view>
    </view>
    <view class="card-link">查看行程详情 →</view>
  </view>

  <view wx:if="{{!loading && !errorText && !hasTrips}}" class="card list-state">
    <view class="empty-mark">TRIP</view>
    <view class="empty-title">{{scope === 'market' ? '暂时没有有效行程' : '你还没有发布行程'}}</view>
    <view class="muted">{{scope === 'market' ? '稍后再来看看已核验的公开路线。' : '填写真实路线和容量后，才能开始匹配。'}}</view>
  </view>

  <view class="button-row">
    <button class="primary-button" bindtap="goCreate">发布行程</button>
    <button wx:if="{{scope === 'mine'}}" class="secondary-button" data-id="{{trips[0].id}}" bindtap="goMatches">查看匹配</button>
  </view>
</view>
