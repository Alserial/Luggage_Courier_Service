.detail-title {
  color: #3d4634;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.compact-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee6d4;
  color: #5f6658;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.detail-error {
  color: #a64d3b;
  font-size: 28rpx;
}

.public-notice {
  border-left: 6rpx solid #7f9070;
}
