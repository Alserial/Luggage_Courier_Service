.match-notice {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #d5dfcf;
  border-radius: 18rpx;
  background: #eef3ea;
}

.notice-check {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #7f9070;
  color: #fffdf7;
  font-size: 25rpx;
  font-weight: 800;
}

.notice-title {
  color: #4f624a;
  font-size: 25rpx;
  font-weight: 700;
}

.notice-desc {
  margin-top: 4rpx;
  color: #6f7c6a;
  font-size: 21rpx;
  line-height: 1.4;
}

.match-card {
  padding: 30rpx;
}

.match-header {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.match-main {
  min-width: 0;
  flex: 1;
}

.route-title {
  color: #3d4634;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.score {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-radius: 18rpx;
  background: #3d4634;
  color: #efe8d8;
  flex-shrink: 0;
}

.score-value {
  font-size: 35rpx;
  font-weight: 800;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.score-label {
  margin-top: 6rpx;
  color: #bfc5b6;
  font-size: 17rpx;
}

.capacity-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 17rpx 18rpx;
  border-radius: 14rpx;
  background: #f4f1e8;
  color: #7f8778;
  font-size: 23rpx;
}

.capacity-value {
  color: #4a5142;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.reason-title {
  margin-top: 24rpx;
  color: #5a6252;
  font-size: 22rpx;
  font-weight: 700;
}

.reason-row {
  margin: 14rpx 0 26rpx;
}

.reason-chip {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: #eef3ea;
  color: #52714d;
  font-size: 21rpx;
}

.empty-state {
  padding: 42rpx 28rpx;
  text-align: center;
}

.empty-mark {
  display: inline-flex;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #eef1e7;
  color: #7f9070;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.empty-title {
  margin-bottom: 8rpx;
  color: #3d4634;
  font-size: 28rpx;
  font-weight: 700;
}

.list-state {
  padding: 36rpx 28rpx;
  text-align: center;
}

.error-text {
  color: #a64d3b;
  font-size: 26rpx;
}

.retry-button {
  margin-top: 20rpx;
}
