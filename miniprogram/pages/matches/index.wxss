.rule-line {
  font-size: 26rpx;
  line-height: 1.55;
}

.match-header {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.score {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-radius: 18rpx;
  background: #0f766e;
  color: #ffffff;
  flex-shrink: 0;
}

.score-value {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.score-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 18rpx;
}

.reason-row {
  margin: 28rpx 0;
}
