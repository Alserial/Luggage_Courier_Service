page {
  height: 100%;
  overflow: hidden;
}

.chat-page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  background: #f4f7f8;
}

.chat-header {
  flex-shrink: 0;
  padding: 22rpx 24rpx 18rpx;
  border-bottom: 1rpx solid #e3e9ec;
  background: #ffffff;
}

.context-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.context-main {
  min-width: 0;
  flex: 1;
}

.context-title {
  overflow: hidden;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-route {
  margin-top: 6rpx;
  overflow: hidden;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connection-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #edf7f5;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.supervision-notice {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fff8e8;
  color: #805b1b;
  font-size: 23rpx;
  line-height: 1.5;
}

.snapshot-button {
  display: inline-flex;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin: 14rpx 0 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(15, 118, 110, 0.22);
  border-radius: 10rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
}

.message-scroll {
  min-height: 0;
  flex: 1;
}

.message-content {
  padding: 24rpx 24rpx 36rpx;
}

.load-more,
.retry-button {
  display: flex;
  width: auto;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 22rpx;
  padding: 0 24rpx;
  border-radius: 10rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 23rpx;
}

.state-card {
  margin: 80rpx 24rpx 0;
  padding: 32rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
  text-align: center;
}

.error-state {
  color: #9f2d2d;
}

.empty-title {
  margin-bottom: 8rpx;
  color: #344054;
  font-size: 28rpx;
  font-weight: 800;
}

.message-row {
  display: flex;
  margin-bottom: 24rpx;
  justify-content: flex-start;
}

.message-mine {
  justify-content: flex-end;
}

.message-system {
  justify-content: center;
}

.message-stack {
  display: flex;
  width: 78%;
  max-width: 560rpx;
  flex-direction: column;
  align-items: flex-start;
}

.message-mine .message-stack {
  align-items: flex-end;
}

.sender-line {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
  color: #7a8791;
  font-size: 21rpx;
  line-height: 1.3;
}

.message-bubble {
  max-width: 100%;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e2e8ec;
  border-radius: 6rpx 14rpx 14rpx;
  background: #ffffff;
  color: #263443;
  font-size: 28rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.message-mine .message-bubble {
  border-color: rgba(15, 118, 110, 0.14);
  border-radius: 14rpx 6rpx 14rpx 14rpx;
  background: #dff4ef;
  color: #164e48;
}

.message-muted {
  border-style: dashed;
  background: #f7f8f9 !important;
  color: #667085 !important;
}

.moderation-label,
.report-action {
  margin-top: 8rpx;
  color: #b45309;
  font-size: 21rpx;
  line-height: 1.35;
}

.report-action {
  color: #667085;
}

.system-message {
  max-width: 86%;
  padding: 12rpx 18rpx;
  border-radius: 10rpx;
  background: #e9eef1;
  color: #52636d;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.message-time {
  margin-top: 5rpx;
  color: #83909a;
  font-size: 20rpx;
}

.message-bottom {
  height: 8rpx;
}

.composer-bar {
  flex-shrink: 0;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dfe6e9;
  background: #ffffff;
}

.composer-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.composer-main {
  position: relative;
  min-width: 0;
  flex: 1;
}

.composer-input {
  width: 100%;
  min-height: 72rpx;
  max-height: 176rpx;
  padding: 16rpx 58rpx 16rpx 18rpx;
  border: 1rpx solid #d7e0e4;
  border-radius: 12rpx;
  background: #f8fafb;
  color: #17202a;
  font-size: 27rpx;
  line-height: 1.45;
}

.character-count {
  position: absolute;
  right: 14rpx;
  bottom: 12rpx;
  color: #98a2a9;
  font-size: 20rpx;
}

.send-button {
  display: flex;
  width: 118rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.read-only-notice {
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  background: #f2f4f5;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

button::after {
  border: 0;
}
