<view class="chat-page">
  <view class="chat-header">
    <view class="context-row">
      <view class="context-main">
        <view class="context-title">{{order.itemName}}</view>
        <view class="context-route">{{order.route}}</view>
      </view>
      <view class="connection-pill">{{realtimeLabel}}</view>
    </view>
    <view class="supervision-notice">
      沟通内容由平台留存并进行安全检查，可用于交易核对与争议处理。请勿交换站外联系方式、私下支付或协商违规物品。
    </view>
    <button class="snapshot-button" loading="{{creatingSnapshot}}" disabled="{{creatingSnapshot}}" bindtap="createEvidenceSnapshot">生成沟通凭证</button>
  </view>

  <scroll-view class="message-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}">
    <view class="message-content">
      <button wx:if="{{hasMore}}" class="load-more" loading="{{loadingMore}}" bindtap="loadMore">加载更早消息</button>

      <view wx:if="{{loading && !messages.length}}" class="state-card">正在加载沟通记录…</view>
      <view wx:elif="{{errorText && !messages.length}}" class="state-card error-state">
        <view>{{errorText}}</view>
        <button class="retry-button" bindtap="retryLoad">重新加载</button>
      </view>
      <view wx:elif="{{!messages.length}}" class="state-card">
        <view class="empty-title">暂无沟通记录</view>
        <view>可以先确认交接时间、地点和物品包装要求。</view>
      </view>

      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="message-{{item.id}}"
        class="message-row {{item.isMine ? 'message-mine' : ''}} {{item.messageType === 'system' ? 'message-system' : ''}}"
      >
        <view wx:if="{{item.messageType === 'system'}}" class="system-message">
          <view>{{item.content}}</view>
          <view class="message-time">{{item.timeText}}</view>
        </view>
        <view wx:else class="message-stack">
          <view class="sender-line">
            <text>{{item.senderLabel}}</text>
            <text>{{item.timeText}}</text>
          </view>
          <view class="message-bubble {{item.moderationStatus !== 'visible' ? 'message-muted' : ''}}">
            {{item.content}}
          </view>
          <view wx:if="{{item.moderationLabel}}" class="moderation-label">{{item.moderationLabel}}</view>
          <view wx:if="{{item.canReport}}" class="report-action" data-id="{{item.id}}" bindtap="reportMessage">举报</view>
        </view>
      </view>
      <view id="message-bottom" class="message-bottom"></view>
    </view>
  </scroll-view>

  <view class="composer-bar">
    <view wx:if="{{conversationStatus !== 'active'}}" class="read-only-notice">订单已结束，沟通记录仅供查看和取证。</view>
    <view wx:else class="composer-row">
      <view class="composer-main">
        <textarea
          class="composer-input"
          value="{{composer}}"
          maxlength="500"
          auto-height
          fixed
          placeholder="在平台内确认交接安排…"
          bindinput="onComposerInput"
        />
        <view class="character-count">{{charactersLeft}}</view>
      </view>
      <button class="send-button" loading="{{sending}}" disabled="{{sending || !composer}}" bindtap="sendMessage">发送</button>
    </view>
  </view>
</view>
