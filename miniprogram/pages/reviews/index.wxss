.review-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.tab-button {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 1rpx solid #d9e2e7;
  border-radius: 14rpx;
  background: #ffffff;
  color: #475467;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-active {
  border-color: rgba(15, 118, 110, 0.18);
  background: #e8f6f3;
  color: #0f766e;
}

.reason-card {
  padding-bottom: 22rpx;
}

.review-card {
  padding-bottom: 22rpx;
}

.review-main {
  margin-bottom: 22rpx;
}

.review-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.small-button {
  display: flex;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
}

.primary-small {
  background: #0f766e;
  color: #ffffff;
}

.secondary-small {
  border: 1rpx solid rgba(15, 118, 110, 0.24);
  background: #ffffff;
  color: #0f766e;
}

.danger-small {
  border: 1rpx solid rgba(220, 38, 38, 0.18);
  background: #fef2f2;
  color: #b91c1c;
}

.refresh-button {
  margin-top: 28rpx;
}

.reported-message {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f6f8f9;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.report-description {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.message-review-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
