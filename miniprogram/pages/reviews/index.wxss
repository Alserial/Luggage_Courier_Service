.review-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.tab-button {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 1rpx solid #ded5c1;
  border-radius: 14rpx;
  background: #fffdf7;
  color: #666e5f;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-active {
  border-color: #7f9070;
  background: #eef3ea;
  color: #5f6e54;
}

.reason-card {
  padding-bottom: 22rpx;
}

.review-card {
  padding-bottom: 22rpx;
}

.review-main {
  margin-bottom: 22rpx;
}

.review-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.small-button {
  display: flex;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
}

.primary-small {
  background: #7f9070;
  color: #fffdf7;
}

.secondary-small {
  border: 1rpx solid #bfc8b5;
  background: #fffdf7;
  color: #5f6e54;
}

.danger-small {
  border: 1rpx solid #efd3ca;
  background: #fbefeb;
  color: #a64d3b;
}

.refresh-button {
  margin-top: 28rpx;
}

.reported-message {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f4f1e8;
  color: #4a5142;
  font-size: 26rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.report-description {
  margin-top: 12rpx;
  color: #7f8778;
  font-size: 24rpx;
  line-height: 1.5;
}

.message-review-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
