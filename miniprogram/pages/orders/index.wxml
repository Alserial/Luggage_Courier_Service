<view class="page">
  <view class="page-header">
    <view class="eyebrow">ORDERS</view>
    <view class="page-title">订单</view>
    <view class="page-desc">跟踪服务费记录、交接、运输、送达和争议证据。</view>
  </view>

  <view class="card order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view>
      <view class="card-title">{{item.itemName}}</view>
      <view class="meta-line">
        <text>{{item.route}}</text>
        <text>{{item.statusLabel}}</text>
      </view>
    </view>
    <view class="amount">{{item.totalText}}</view>
  </view>

  <view wx:if="{{!hasOrders}}" class="card">
    <view class="muted">还没有订单，接受报价后会显示在这里。</view>
  </view>

  <view class="card">
    <view class="timeline-title">MVP 状态机</view>
    <view class="status-grid">
      <view class="status-line" wx:for="{{statuses}}" wx:key="value">{{item.label}}</view>
    </view>
  </view>
</view>
