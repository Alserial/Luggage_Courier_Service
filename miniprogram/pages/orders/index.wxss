.timeline-title {
  margin-bottom: 10rpx;
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
}

.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.status-line {
  padding: 14rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f8fa;
  color: #475467;
  font-size: 24rpx;
  text-align: center;
}

.order-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.amount {
  flex-shrink: 0;
  color: #0f766e;
  font-size: 30rpx;
  font-weight: 900;
}
