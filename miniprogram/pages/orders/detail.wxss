.order-hero {
  margin-bottom: 22rpx;
  padding: 34rpx;
  border-radius: 22rpx;
  background: #3d4634;
  color: #efe8d8;
}

.order-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-eyebrow {
  color: #aeb9a3;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.hero-status {
  padding: 9rpx 16rpx;
  border: 1rpx solid rgba(239, 232, 216, 0.2);
  border-radius: 999rpx;
  background: rgba(239, 232, 216, 0.1);
  color: #efe8d8;
  font-size: 21rpx;
  font-weight: 700;
}

.order-title {
  margin-top: 22rpx;
  font-size: 39rpx;
  font-weight: 800;
  line-height: 1.3;
  word-break: break-word;
}

.order-route {
  margin-top: 12rpx;
  color: #d9ddD3;
  font-size: 27rpx;
  font-weight: 700;
}

.order-caption {
  overflow: hidden;
  margin-top: 16rpx;
  color: #adb5a5;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.next-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #d5dfcf;
  border-radius: 20rpx;
  background: #eef3ea;
}

.next-kicker {
  color: #7f9070;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.next-title {
  margin-top: 9rpx;
  color: #42513f;
  font-size: 30rpx;
  font-weight: 800;
}

.next-desc {
  margin: 10rpx 0 22rpx;
  color: #687964;
  font-size: 23rpx;
  line-height: 1.55;
}

.inline-error {
  margin-bottom: 18rpx;
  color: #a64d3b;
  font-size: 23rpx;
}

.cancel-button {
  display: flex;
  width: 100%;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  border: 1rpx solid #d9b7ad;
  border-radius: 14rpx;
  background: #fffdf7;
  color: #a64d3b;
  font-size: 24rpx;
  font-weight: 700;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 12rpx;
}

.card-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.compact-title {
  margin-bottom: 5rpx;
  font-size: 29rpx;
}

.section-helper {
  color: #8b9382;
  font-size: 21rpx;
  line-height: 1.5;
}

.progress-number {
  color: #5f6e54;
  font-size: 27rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #e7e1d2;
}

.progress-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #7f9070;
}

.timeline-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 12rpx;
  margin-top: 26rpx;
}

.timeline-row {
  display: flex;
  align-items: center;
  gap: 11rpx;
  min-width: 0;
}

.dot {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d2ccbc;
  border-radius: 50%;
  background: #f1ede3;
  color: #fffdf7;
  font-size: 17rpx;
  flex-shrink: 0;
}

.dot-done {
  border-color: #7f9070;
  background: #7f9070;
}

.timeline-label {
  overflow: hidden;
  color: #9a9f92;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-label-done {
  color: #556051;
  font-weight: 700;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  color: #60685a;
  font-size: 27rpx;
  font-variant-numeric: tabular-nums;
}

.total {
  margin-top: 8rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee6d4;
  color: #3d4634;
  font-weight: 800;
}

.payment-boundary {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f7edd7;
  color: #765b22;
  font-size: 21rpx;
  line-height: 1.5;
}

.evidence-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.evidence-count {
  flex-shrink: 0;
  min-width: 98rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #eef1e7;
  text-align: center;
}

.evidence-number {
  color: #5f6e54;
  font-size: 31rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.evidence-label {
  margin-top: 2rpx;
  color: #7f8778;
  font-size: 18rpx;
}

.evidence-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee6d4;
}

.evidence-name {
  color: #42513f;
  font-size: 25rpx;
  font-weight: 700;
}

.evidence-action {
  color: #5f6e54;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.rule-text {
  font-size: 24rpx;
  line-height: 1.6;
}

.dispute-button {
  display: flex;
  width: 100%;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0 0;
  padding: 0 22rpx;
  border: 1rpx solid #d9b7ad;
  border-radius: 16rpx;
  background: transparent;
  color: #a64d3b;
  font-size: 25rpx;
  font-weight: 700;
}
