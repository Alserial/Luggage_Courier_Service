.order-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.order-title {
  color: #111827;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.compact-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
}

.progress-track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8eef1;
}

.progress-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #0f766e;
}

.timeline-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 20rpx;
  color: #374151;
  font-size: 26rpx;
  line-height: 1.45;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #d1d5db;
  box-shadow: 0 0 0 1rpx #d1d5db;
  flex-shrink: 0;
}

.dot-done {
  background: #0f766e;
  box-shadow: 0 0 0 1rpx #0f766e;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  color: #374151;
  font-size: 28rpx;
}

.total {
  margin-top: 8rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e8eef1;
  color: #111827;
  font-weight: 900;
}

.rule-text {
  font-size: 26rpx;
  line-height: 1.55;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 0;
}
