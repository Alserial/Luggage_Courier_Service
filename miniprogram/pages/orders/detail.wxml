<view class="page safe-bottom">
  <view wx:if="{{loading && !hasOrder}}" class="card"><view class="muted">正在读取订单...</view></view>
  <view wx:if="{{errorText && !hasOrder}}" class="card warning">{{errorText}}</view>
  <block wx:if="{{hasOrder}}">
  <view class="order-hero">
    <view class="order-hero-top">
      <view class="hero-eyebrow">ORDER DETAIL</view>
      <view class="hero-status">{{statusLabel}}</view>
    </view>
    <view class="order-title">{{order.itemName}}</view>
    <view class="order-route">{{order.route}}</view>
    <view class="order-caption">订单号 {{order.id}} · 以平台记录为准</view>
  </view>

  <view class="next-card">
    <view class="next-kicker">NEXT ACTION</view>
    <view class="next-title">{{nextTitle}}</view>
    <view class="next-desc">支付、交接、送达和异常处理都应通过平台入口操作并形成记录。</view>
    <button wx:if="{{canPay}}" class="primary-button" bindtap="goPayment">确认 Mock 服务费</button>
    <button wx:if="{{canHandover}}" class="primary-button" bindtap="goHandover">出发地交接确认</button>
    <button wx:if="{{canStartTransit}}" class="primary-button" loading="{{submitting}}" data-status="in_transit" bindtap="confirmTransition">确认进入在途</button>
    <button wx:if="{{canArrive}}" class="primary-button" loading="{{submitting}}" data-status="arrived" bindtap="confirmTransition">确认抵达目的地</button>
    <button wx:if="{{needsDeliveryEvidence}}" class="primary-button" data-type="delivery_photo_or_video" bindtap="goEvidence">上传送达照片/视频</button>
    <button wx:if="{{canDeliver}}" class="primary-button" loading="{{submitting}}" data-status="delivered" bindtap="confirmTransition">确认已送达</button>
    <button wx:if="{{canComplete}}" class="primary-button" loading="{{submitting}}" data-status="completed" bindtap="confirmTransition">确认收货并完成</button>
    <button wx:if="{{canCancel}}" class="cancel-button" loading="{{submitting}}" bindtap="cancelOrder">取消待支付订单</button>
    <view class="quick-actions">
      <button class="secondary-button" bindtap="goChat">订单内沟通</button>
      <button class="secondary-button" bindtap="goEvidence">上传证据</button>
    </view>
  </view>

  <view class="card">
    <view class="card-section-head">
      <view>
        <view class="section-title compact-title">履约进度</view>
        <view class="section-helper">已完成状态会保留在订单审计记录中</view>
      </view>
      <view class="progress-number">{{progress}}%</view>
    </view>
    <view class="progress-track">
      <view class="progress-bar" style="width: {{progress}}%;"></view>
    </view>
    <view class="timeline-list">
      <view class="timeline-row" wx:for="{{timeline}}" wx:key="value">
        <view class="dot {{item.done ? 'dot-done' : ''}}">
          <text wx:if="{{item.done}}">✓</text>
        </view>
        <view class="timeline-label {{item.done ? 'timeline-label-done' : ''}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title compact-title">服务费记录</view>
    <view class="fee-row"><text>帮带服务费</text><text>{{fee.serviceFee}}</text></view>
    <view class="fee-row"><text>平台服务费</text><text>{{fee.platformFee}}</text></view>
    <view class="fee-row total"><text>合计</text><text>{{fee.total}}</text></view>
    <view class="payment-boundary">当前仅为支付占位；真实支付、分账、退款和放款需接入合规支付服务。</view>
  </view>

  <view class="card evidence-summary">
    <view>
      <view class="section-title compact-title">证据记录</view>
      <view class="section-helper">物品、交接、沟通、服务费和送达等关键动作应保留凭证。</view>
    </view>
    <view class="evidence-count">
      <view class="evidence-number">{{order.evidenceCount}}</view>
      <view class="evidence-label">份记录</view>
    </view>
  </view>

  <view wx:if="{{evidence.length}}" class="card">
    <view class="section-title compact-title">证据明细</view>
    <view
      class="evidence-row"
      wx:for="{{evidence}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="previewEvidence"
    >
      <view>
        <view class="evidence-name">{{item.label}}</view>
        <view class="section-helper">{{item.description || '平台系统记录'}} {{item.createdText}}</view>
      </view>
      <view class="evidence-action">{{item.fileCount ? '预览' : '记录'}}</view>
    </view>
  </view>

  <view class="card warning">
    <view class="section-title compact-title">税费与通关提示</view>
    <view class="rule-text">{{order.taxRule}}</view>
  </view>

  <button wx:if="{{canDispute}}" class="dispute-button" bindtap="goDispute">出现问题，提交争议与证据</button>
  </block>
</view>
