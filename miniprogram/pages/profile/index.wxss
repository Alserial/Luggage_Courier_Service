.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-name {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.rule-button,
.review-button {
  margin-top: 18rpx;
}

.login-note {
  margin-top: 24rpx;
}

.login-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
}
