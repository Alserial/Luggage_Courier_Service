.profile-hero {
  padding: 32rpx;
  border-radius: 22rpx;
  background: #3d4634;
  color: #efe8d8;
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #7f9070;
  color: #fffdf7;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 800;
}

.profile-caption {
  margin-top: 7rpx;
  color: #bfc5b6;
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 28rpx;
}

.profile-stat {
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(239, 232, 216, 0.18);
  border-radius: 15rpx;
  background: rgba(239, 232, 216, 0.08);
  text-align: center;
}

.stat-value {
  overflow: hidden;
  color: #fffdf7;
  font-size: 27rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  margin-top: 4rpx;
  color: #bfc5b6;
  font-size: 19rpx;
}

.login-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #e1d8c3;
  border-radius: 20rpx;
  background: #fffdf7;
}

.login-card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.login-mark {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  background: #eef3ea;
  color: #5f6e54;
  font-size: 23rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.login-title {
  color: #3d4634;
  font-size: 27rpx;
  font-weight: 800;
}

.login-desc {
  margin-top: 5rpx;
  color: #7f8778;
  font-size: 21rpx;
  line-height: 1.5;
}

.user-id {
  overflow: hidden;
  margin-bottom: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f4f1e8;
  color: #7f8778;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card {
  overflow: hidden;
  margin-top: 22rpx;
  border: 1rpx solid #e1d8c3;
  border-radius: 20rpx;
  background: #fffdf7;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #eee6d4;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-icon {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eef1e7;
  color: #5f6e54;
  font-size: 21rpx;
  font-weight: 800;
}

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-title {
  color: #3d4634;
  font-size: 26rpx;
  font-weight: 700;
}

.menu-desc {
  margin-top: 4rpx;
  color: #8b9382;
  font-size: 21rpx;
  line-height: 1.4;
}

.menu-arrow {
  color: #a9ae9f;
  font-size: 36rpx;
}

.boundary-note {
  margin-top: 26rpx;
  color: #8b9382;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
