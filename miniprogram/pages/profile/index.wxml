<view class="page safe-bottom">
  <view class="page-header">
    <view class="eyebrow">PROFILE</view>
    <view class="page-title">我的</view>
  </view>

  <view class="profile-hero">
    <view class="profile-top">
      <view class="avatar">{{loggedIn ? '用' : 'K'}}</view>
      <view class="profile-main">
        <view class="profile-name">{{loggedIn ? '已登录用户' : '欢迎使用 Kargo'}}</view>
        <view class="profile-caption">{{loggedIn ? '微信身份已由云函数校验' : '登录后查看订单、审核与凭证记录'}}</view>
      </view>
    </view>
    <view class="profile-stats">
      <view class="profile-stat">
        <view class="stat-value">{{loggedIn ? completedOrders : '-'}}</view>
        <view class="stat-label">已完成订单</view>
      </view>
      <view class="profile-stat">
        <view class="stat-value">{{loggedIn ? verificationStatus : '-'}}</view>
        <view class="stat-label">认证状态</view>
      </view>
    </view>
  </view>

  <view class="login-card">
    <view class="login-card-head">
      <view class="login-mark">✓</view>
      <view>
        <view class="login-title">微信身份登录</view>
        <view class="login-desc">凭证由微信与云函数校验，前端不保存密码或展示 OpenID。</view>
      </view>
    </view>
    <view wx:if="{{userId}}" class="user-id">用户记录：{{userId}}</view>
    <button class="primary-button" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="wechatLogin">{{loggedIn ? '刷新微信登录状态' : '微信一键登录'}}</button>
  </view>

  <view class="menu-card">
    <view wx:if="{{canReview}}" class="menu-row" bindtap="goReviews">
      <view class="menu-icon">审</view>
      <view class="menu-copy">
        <view class="menu-title">审核后台</view>
        <view class="menu-desc">处理品类、行程和内容审核</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goRules">
      <view class="menu-icon">规</view>
      <view class="menu-copy">
        <view class="menu-title">平台规则</view>
        <view class="menu-desc">查看允许品类、禁止范围和责任提示</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="boundary-note">Kargo 仅提供低风险小件的信息匹配与履约留痕工具，不承诺清关或保证送达。</view>
</view>
